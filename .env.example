# =============================================================================
# Variáveis de ambiente — Tesouro App
# Copie este arquivo para .env e preencha os valores antes de iniciar
# =============================================================================

# ── Banco de dados ─────────────────────────────────────────────────────────
#
# Desenvolvimento local com SQLite:
#   DATABASE_URL="file:./dev.db"
#
# PostgreSQL local (após criar banco conforme DEPLOY.md seção 5):
#   DATABASE_URL="postgresql://tesouro_user:SENHA@localhost:5432/tesouro_db"
#
# PostgreSQL na rede interna SEFAZ:
#   DATABASE_URL="postgresql://tesouro_user:SENHA@192.168.X.X:5432/tesouro_db"
#
# PostgreSQL com SSL (CA interna):
#   DATABASE_URL="postgresql://tesouro_user:SENHA@192.168.X.X:5432/tesouro_db?sslmode=require"
#
DATABASE_URL="postgresql://tesouro_user:TROQUE_ESTA_SENHA@localhost:5432/tesouro_db"

# ── Variáveis do Docker Compose (usadas pelo docker-compose.yml) ────────────
# Necessárias apenas se estiver usando Docker com banco interno do compose
DB_USER=tesouro_user
DB_PASSWORD=TROQUE_ESTA_SENHA
DB_NAME=tesouro_db

# ── NextAuth ────────────────────────────────────────────────────────────────
#
# Chave secreta para assinar tokens JWT de sessão.
# OBRIGATÓRIO: gere um valor único com o comando abaixo e cole aqui:
#   openssl rand -base64 32
# Nunca use o valor de exemplo em produção.
#
NEXTAUTH_SECRET="SUBSTITUA-POR-VALOR-GERADO-COM-openssl-rand-base64-32"

# URL base da aplicação (sem barra final)
# Deve ser exatamente a URL que os usuários digitam no navegador.
#
# Desenvolvimento: http://localhost:3000
# Homologação:     http://IP_SERVIDOR:3000
# Produção SEFAZ:  http://tesouro.sefaz.es.gov.br
#                  https://tesouro.sefaz.es.gov.br (se houver certificado)
#
NEXTAUTH_URL="http://localhost:3000"
